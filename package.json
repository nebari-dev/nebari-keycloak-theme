{
  "name": "nebari-keycloak-theme",
  "version": "2.0.0",
  "description": "Keycloak login, account and admin themes in the Nebari design system, built with Keycloakify.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nebari-dev/nebari-keycloak-theme.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19 || >=22.12"
  },
  "scripts": {
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "build": "npm run check && tsc && vite build",
    "build-keycloak-theme": "node scripts/build-keycloak-themes.mjs",
    "check": "npm run check:page-nav-sync && npm run check:patternfly-version",
    "check:page-nav-sync": "node scripts/check-page-nav-sync.mjs",
    "check:patternfly-version": "node scripts/check-patternfly-version.mjs",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "npm run check && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:screenshots": "playwright test --project=chromium",
    "test:screenshots:update": "playwright test --project=chromium --update-snapshots=all",
    "test:a11y": "playwright test --project=a11y-login",
    "test:a11y:consoles": "playwright test -c playwright.consoles.config.ts --project=a11y-admin --project=a11y-account",
    "docs:console-images": "playwright test -c playwright.consoles.config.ts --project=docs-images"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@keycloak/keycloak-admin-client": "26.5.2",
    "@keycloakify/keycloak-account-ui": "~260502.0.2",
    "@keycloakify/keycloak-admin-ui": "~260502.0.0",
    "@keycloakify/keycloak-ui-shared": "~260502.0.0",
    "@patternfly/patternfly": "^5.4.2",
    "@patternfly/react-core": "^5.4.14",
    "@patternfly/react-icons": "^5.4.2",
    "@patternfly/react-styles": "^5.4.1",
    "@patternfly/react-table": "^5.4.16",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "flat": "^6.0.1",
    "i18next": "^25.7.3",
    "i18next-fetch-backend": "^6.0.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.22",
    "lucide-react": "^1.56.0",
    "oidc-spa": "~10.0.5",
    "p-debounce": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.70.0",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^6.30.2",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.7.0",
    "use-react-router-breadcrumbs": "^4.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "4.14.0",
    "keycloakify": "^11.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^7.3.7"
  }
}