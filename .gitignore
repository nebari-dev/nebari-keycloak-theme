# TypeScript project-reference output. `tsc -b` emits these next to the config
# it builds, and tsconfig.node.json covers vite.config.ts, so a type-check run
# leaves a compiled copy of the Vite config in the working tree.
*.tsbuildinfo
vite.config.js
vite.config.d.ts
